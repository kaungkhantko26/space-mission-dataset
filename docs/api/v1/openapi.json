{
 "openapi": "3.0.3",
 "info": {
  "title": "Space Mission Research Data API",
  "version": "1.0.0",
  "description": "Static read-only JSON API. 32 records are verified (25 celestial bodies at core level; engines and stages whose core numeric fields were all checked) against retrieved JPL, NASA (NTRS, SLS page, Apollo 11 press kit), ULA and ESA pages. 198 celestial and 66 launch/engine field checks matched; 16 celestial and 13 launch/engine recalled values were wrong or outdated and were replaced by the sourced value. Launch vehicles are verified field by field only (see verified_field_count); everything not checked (e.g. Falcon, Starship, Electron, Ariane, most engines, spacecraft components, instruments, missions) is still unverified, as are two user-supplied tables. Derived values inherit the status of their inputs. Optimization catalog values are estimated/fictional."
 },
 "servers": [
  {
   "url": "https://kaungkhantko26.github.io/space-mission-dataset/api/v1",
   "description": "GitHub Pages"
  },
  {
   "url": "http://localhost:8000/api/v1",
   "description": "Local (python3 -m http.server in docs/)"
  }
 ],
 "paths": {
