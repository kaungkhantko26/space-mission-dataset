{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "dataset",
  "record_count",
  "records"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "dataset": {
   "type": "string"
  },
  "record_count": {
   "type": "integer"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "parent_id",
     "gravitational_parameter_km3_s2",
     "mean_radius_m",
     "data_class",
     "confidence",
     "source_ids",
     "retrieval_status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "data_class": {
      "enum": [
       "verified",
       "derived",
       "estimated",
       "fictional",
       "unverified"
      ]
     },
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[SG][0-9]{2}$"
      }
     },
     "retrieval_status": {
      "enum": [
       "not_retrieved",
       "retrieved"
      ]
     },
     "gravitational_parameter_km3_s2": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "mean_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    }
   }
  }
 }
}