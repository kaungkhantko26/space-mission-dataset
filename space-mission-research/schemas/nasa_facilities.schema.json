{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "dataset",
  "record_count",
  "records"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "dataset": {
   "type": "string"
  },
  "record_count": {
   "type": "integer"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "center",
     "facility",
     "category",
     "data_class",
     "confidence",
     "source_ids",
     "retrieval_status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "data_class": {
      "enum": [
       "verified",
       "derived",
       "estimated",
       "fictional",
       "unverified"
      ]
     },
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[SG][0-9]{2}$"
      }
     },
     "retrieval_status": {
      "enum": [
       "not_retrieved",
       "retrieved",
       "user_supplied_not_independently_verified"
      ]
     },
     "lat": {
      "type": [
       "number",
       "null"
      ],
      "minimum": -90,
      "maximum": 90
     },
     "lon": {
      "type": [
       "number",
       "null"
      ],
      "minimum": -180,
      "maximum": 180
     },
     "status": {
      "enum": [
       "active",
       "inactive",
       "under_rehabilitation",
       null
      ]
     }
    }
   }
  }
 }
}