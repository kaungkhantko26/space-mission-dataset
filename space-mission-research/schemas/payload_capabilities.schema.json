{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "dataset",
  "record_count",
  "records"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "dataset": {
   "type": "string"
  },
  "record_count": {
   "type": "integer"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "vehicle_id",
     "orbit",
     "payload_kg",
     "mode"
    ],
    "properties": {
     "payload_kg": {
      "type": "number"
     },
     "data_class": {
      "enum": [
       "verified",
       "derived",
       "estimated",
       "fictional",
       "unverified"
      ]
     },
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[SG][0-9]{2}$"
      }
     }
    }
   }
  }
 }
}